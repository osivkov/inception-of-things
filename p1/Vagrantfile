# -*- mode: ruby -*-
BOX = "bento/debian-13"

MACHINES = [
  { name: "osivkovS",  ip: "192.168.56.110", script: "scripts/server.sh", memory: 1024 },
  { name: "osivkovSW", ip: "192.168.56.111", script: "scripts/agent.sh",  memory: 1024 },
]

Vagrant.configure("2") do |config|
  config.vm.box = BOX
  config.vm.boot_timeout = 600
  config.vm.synced_folder ".", "/vagrant", type: "virtualbox"

  MACHINES.each do |m|
    config.vm.define m[:name] do |node|
      node.vm.hostname = m[:name]
      node.vm.network "private_network", ip: m[:ip]

      node.vm.provider "virtualbox" do |vb|
        vb.name   = m[:name]
        vb.cpus   = 1
        vb.memory = m[:memory]
        vb.customize ["modifyvm", :id, "--uartmode1", "disconnected"]
        vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
      end

      node.vm.provision "shell", path: m[:script], env: { "NODE_IP" => m[:ip] }
    end
  end
end
